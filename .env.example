# Docker Compose loads variables from a root .env file automatically.
# Copy the values you need into .env before running `docker compose up`.

# Optional Hugging Face token for faster authenticated model downloads.
HF_TOKEN=

# LeanExplore data version to pin inside the container.
# Leave blank to use the active_version file or the latest fetched version.
LEAN_EXPLORE_VERSION=20260507_203639

# Optional override for the lean_explore smoke test reranking depth.
LEAN_EXPLORE_RERANK_TOP=0